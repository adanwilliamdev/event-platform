# Porta do servidor HTTP
PORT=8000

# Caminho do arquivo SQLite (padrão: ./eventplatform.db)
DATABASE_PATH=./eventplatform.db

# Chave usada para assinar os tokens JWT (troque em produção)
JWT_SECRET=dev-secret-change-me-in-production-please

# Opcional: só é necessário se você configurar chaves reais do Stripe
# para usar pagamentos em vez do modo de demonstração.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
